{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codonforge.org/schemas/v1/landscape_lockfile.schema.json",
  "title": "LandscapeLockfile",
  "description": "The exact set of artifacts, engines, data and RNG state that produced a result. Analogous to a package-manager lockfile, and it is the mechanism that makes three otherwise-conflicting requirements compatible at once:\n\n  * results are reproducible and auditable (BRIEF-2.2-d);\n  * a submitted wet-lab observation triggers recalibration WITHOUT blocking or perturbing other users' in-flight jobs (BRIEF-2.4-b) - because every job pins its lockfile at submission, a new artifact version appearing mid-job is simply not visible to it;\n  * host/dataset-specific model versions are selected at query time by a documented ladder (BRIEF-2.4-c) - the ladder runs ONCE, at pin time, and its outcome is recorded here rather than re-derived per query.\n\nA lockfile is immutable and content-addressed. Replaying a job means loading its lockfile and re-running; if any digest is unavailable the replay fails loudly rather than substituting a newer artifact.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "lockfile_id": { "type": "string", "pattern": "^lock_[0-9A-HJKMNP-TV-Z]{26}$" },
    "created_at": { "$ref": "common.schema.json#/$defs/Iso8601" },
    "job_id": { "$ref": "common.schema.json#/$defs/JobId" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/TenantId" },
    "contract_major": { "$ref": "common.schema.json#/$defs/ContractMajor" },
    "resolution": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per requested term. Every entry is fully pinned: an artifact_id alone is not enough because channels move.",
      "items": {
        "type": "object",
        "properties": {
          "term_id": { "$ref": "common.schema.json#/$defs/TermId" },
          "artifact_id": { "$ref": "common.schema.json#/$defs/ArtifactId" },
          "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
          "resolved_by": { "enum": ["pin", "tenant_channel", "host_channel", "nearest_host", "base", "builtin"] },
          "channel": { "type": ["string", "null"], "examples": ["stable", "candidate", "nightly", null] },
          "fallback": { "type": "boolean", "default": false },
          "host_distance": {
            "type": ["object", "null"],
            "description": "Populated only when resolved_by = nearest_host. Records why this substitution was considered acceptable and by how much uncertainty was inflated.",
            "properties": {
              "substitute_host_id": { "$ref": "common.schema.json#/$defs/HostId" },
              "taxonomic_rank_of_lca": { "enum": ["strain", "species", "genus", "family", "order", "class", "phylum", "domain", "root"] },
              "codon_usage_cosine": { "type": "number", "minimum": -1, "maximum": 1 },
              "trna_pool_cosine": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
              "uncertainty_inflation_factor": { "type": "number", "minimum": 1 }
            },
            "required": ["substitute_host_id", "taxonomic_rank_of_lca", "uncertainty_inflation_factor"],
            "additionalProperties": false
          }
        },
        "required": ["term_id", "artifact_id", "digest", "resolved_by"],
        "additionalProperties": false
      }
    },
    "engines": {
      "type": "array",
      "description": "Non-model compute engines whose version changes the numbers (structure folding above all).",
      "items": {
        "type": "object",
        "properties": {
          "role": { "enum": ["structure", "kmer_index", "hypervolume", "conformal"] },
          "name": { "type": "string", "examples": ["native_window", "viennarna", "linearfold", "wfg"] },
          "version": { "type": "string" },
          "digest": { "type": ["string", "null"] },
          "parameters": { "type": "object", "additionalProperties": true }
        },
        "required": ["role", "name", "version"],
        "additionalProperties": false
      }
    },
    "host_profile": {
      "type": "object",
      "properties": {
        "host_id": { "$ref": "common.schema.json#/$defs/HostId" },
        "version": { "$ref": "common.schema.json#/$defs/SemVer" },
        "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" }
      },
      "required": ["host_id", "version", "digest"],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "construct_digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
        "constraint_set_digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
        "seed_set_digest": { "type": ["string", "null"] },
        "input_sequence_digests": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Sha256Digest" } }
      },
      "required": ["construct_digest", "constraint_set_digest"],
      "additionalProperties": false
    },
    "rng": {
      "type": "object",
      "description": "Determinism contract. A parallel search is only reproducible if each worker's stream is derived deterministically from the root seed and the reduction order is fixed - floating-point summation is not associative, so 'same seed, different thread count' is otherwise a different answer.",
      "properties": {
        "algorithm": { "enum": ["pcg64", "chacha8", "xoshiro256pp"] },
        "root_seed": { "type": "integer", "minimum": 0 },
        "stream_assignment": { "enum": ["per_block_index", "per_individual_index", "per_worker"], "description": "per_block_index and per_individual_index are thread-count-independent; per_worker is not and is only legal for `fast` tier." },
        "deterministic_reduction": { "type": "boolean", "description": "When true, all cross-thread float reductions use a fixed tree order. Costs ~3% throughput and is required for any published result." }
      },
      "required": ["algorithm", "root_seed", "stream_assignment", "deterministic_reduction"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "codonforge_version": { "$ref": "common.schema.json#/$defs/SemVer" },
        "git_sha": { "type": "string" },
        "platform": { "type": "string" },
        "thread_count": { "type": "integer", "minimum": 1 },
        "budget_tier": { "$ref": "common.schema.json#/$defs/BudgetTier" }
      },
      "required": ["codonforge_version", "budget_tier"],
      "additionalProperties": false
    },
    "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" }
  },
  "required": ["schema_version", "lockfile_id", "created_at", "contract_major", "resolution", "host_profile", "inputs", "rng", "environment", "digest"],
  "additionalProperties": false
}
