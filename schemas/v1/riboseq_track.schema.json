{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna_design_suite.org/schemas/v1/riboseq_track.schema.json",
  "title": "RiboSeqTrack",
  "description": "Ribosome-profiling reference data (BRIEF-2.2-c). This is the training input for the epistatic surface's dwell head.\n\nSTORAGE IS OUT-OF-LINE BY DEFAULT. A single bacterial Ribo-seq dataset is ~1.3 million codon observations per replicate; embedding counts in JSON would produce ~30 MB documents that no reviewer can read and no cache can hold. The document therefore describes the data and points at a Parquet blob by digest. `inline` storage exists only for the synthetic test suite and for small golden fixtures.\n\nPROCESSING METADATA IS MANDATORY, NOT OPTIONAL. A-site offset assignment is the single largest source of between-lab disagreement in codon-level dwell estimates; two tracks processed with different offset rules are not poolable. Recording the rule is what makes the cross-dataset generalization experiment EXP-01 interpretable.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "dataset_id": { "type": "string", "pattern": "^ds_[A-Za-z0-9_.-]{3,64}$" },
    "host_id": { "$ref": "common.schema.json#/$defs/HostId" },
    "accession": { "type": ["string", "null"], "description": "GEO/SRA/ENA accession, or null for unpublished tenant data." },
    "tenant_id": { "$ref": "common.schema.json#/$defs/TenantId" },
    "condition_id": { "type": "string" },
    "assay": { "enum": ["riboseq", "riboseq_disome", "tcp_seq", "synthetic"], "default": "riboseq" },
    "replicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "replicate_id": { "type": "string" },
          "kind": { "enum": ["biological", "technical"] },
          "run_accession": { "type": ["string", "null"] },
          "mapped_reads": { "type": "integer", "minimum": 0 }
        },
        "required": ["replicate_id", "kind"],
        "additionalProperties": false
      }
    },
    "processing": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string" },
        "trimmer": { "type": "string" },
        "aligner": { "type": "string" },
        "aligner_version": { "type": "string" },
        "reference_annotation": { "type": "string" },
        "dedup": { "enum": ["none", "umi", "positional"] },
        "a_site_offset_method": {
          "enum": ["fixed", "per_read_length", "metagene_start", "riboWaltz_like", "none"],
          "description": "How the A-site was assigned from the footprint 5' end. `none` means positions are 5'-end based and the dwell head must model the offset itself."
        },
        "offsets_by_read_length": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]{1,3}$" },
          "additionalProperties": { "type": "integer" },
          "description": "read length (nt) -> offset (nt). Required when a_site_offset_method = per_read_length."
        },
        "read_length_range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "excluded_regions": {
          "type": "object",
          "properties": {
            "first_codons": { "type": "integer", "minimum": 0, "default": 15, "description": "Codons trimmed from the CDS 5' end. Initiation-phase footprints are dominated by initiation kinetics, not elongation context, and including them biases the epistatic couplings." },
            "last_codons": { "type": "integer", "minimum": 0, "default": 5 },
            "overlapping_orfs": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "drug": { "type": ["string", "null"], "examples": ["chloramphenicol", "cycloheximide", "none", null], "description": "Elongation inhibitors distort the dwell profile. Tracks with a drug and tracks without must not be pooled without an explicit batch term." }
      },
      "required": ["aligner", "a_site_offset_method"],
      "additionalProperties": false
    },
    "normalization": {
      "type": "object",
      "properties": {
        "method": { "enum": ["raw_counts", "rpm", "gene_normalized", "gene_normalized_log", "z_within_gene"] },
        "pseudocount": { "type": "number", "minimum": 0, "default": 0.5 },
        "min_gene_reads": { "type": "integer", "minimum": 0, "default": 64 },
        "min_gene_codons": { "type": "integer", "minimum": 0, "default": 100 }
      },
      "required": ["method"],
      "additionalProperties": false
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "title": "ParquetStorage",
          "properties": {
            "kind": { "const": "parquet" },
            "uri": { "type": "string" },
            "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
            "bytes": { "type": "integer", "minimum": 0 },
            "columns": {
              "type": "array",
              "description": "Declared column layout so a reader never guesses. Required columns: gene_id, cds_digest, codon_index, codon, count, replicate_id.",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "dtype": { "enum": ["int32", "int64", "float32", "float64", "string", "bool"] },
                  "nullable": { "type": "boolean", "default": false }
                },
                "required": ["name", "dtype"],
                "additionalProperties": false
              }
            },
            "n_rows": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "uri", "digest", "columns"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "InlineStorage",
          "properties": {
            "kind": { "const": "inline" },
            "genes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gene_id": { "type": "string" },
                  "cds_digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
                  "cds": { "$ref": "common.schema.json#/$defs/CodonString" },
                  "counts": { "type": "array", "items": { "type": "number", "minimum": 0 } },
                  "replicate_id": { "type": "string" }
                },
                "required": ["gene_id", "counts"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "genes"],
          "additionalProperties": false
        }
      ]
    },
    "qc": {
      "type": "object",
      "description": "Gate values checked at ingest. A track failing any threshold is loadable but flagged, and the fitter excludes flagged tracks unless explicitly overridden.",
      "properties": {
        "triplet_periodicity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Fraction of reads in the dominant frame. Gate: >= 0.60." },
        "frac_cds_assigned": { "type": "number", "minimum": 0, "maximum": 1 },
        "n_genes_passing": { "type": "integer", "minimum": 0 },
        "median_codon_depth": { "type": "number", "minimum": 0 },
        "total_assigned_codons": { "type": "integer", "minimum": 0 },
        "replicate_spearman": { "type": ["number", "null"], "minimum": -1, "maximum": 1, "description": "Between-replicate gene-level correlation. Gate: >= 0.85." },
        "flags": { "type": "array", "items": { "enum": ["low_periodicity", "low_depth", "replicate_discordant", "drug_treated", "unsupported_offsets", "small_n_genes"] }, "default": [] }
      },
      "required": ["triplet_periodicity", "total_assigned_codons"],
      "additionalProperties": false
    },
    "sharing": { "enum": ["public", "tenant", "community_pooled"], "default": "tenant" },
    "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" }
  },
  "required": ["schema_version", "dataset_id", "host_id", "replicates", "processing", "normalization", "storage", "qc", "digest"],
  "additionalProperties": false
}
