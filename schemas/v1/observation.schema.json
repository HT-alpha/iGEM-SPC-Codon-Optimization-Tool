{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dna_design_suite.org/schemas/v1/observation.schema.json",
  "title": "WetLabObservation",
  "description": "The active-learning ingestion payload (BRIEF-2.4-b): a measured outcome for a designed (or any) construct.\n\nWHAT THIS SCHEMA IS DEFENDING AGAINST. Wet-lab readouts are only usable for recalibration if they are comparable, and the three things that most often make them incomparable are: an unstated normalization, a missing control, and an undeclared assay dynamic range. All three are required fields here. A submission that omits them is rejected at the API boundary rather than silently poisoning a model.\n\nTHE `exploration` BLOCK IS NOT BOOKKEEPING. Recalibrating a model on data generated by that model's own top-ranked suggestions is a closed feedback loop with a known failure mode: the model becomes confidently wrong outside the region it already likes. DNA Design Suite therefore requires that a fraction of every submitted batch be drawn from a randomized exploration arm, and records the assignment so the fitter can reweight. See AMD-004 and ADR-0006.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "observation_id": { "type": "string", "pattern": "^obs_[0-9A-HJKMNP-TV-Z]{26}$" },
    "submitted_at": { "$ref": "common.schema.json#/$defs/Iso8601" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/TenantId" },
    "submitter": { "type": "string" },
    "batch_id": { "type": ["string", "null"], "description": "Groups observations measured together. Batch is a mandatory random effect in the recalibration model; without it, plate-to-plate variation is absorbed into codon coefficients." },
    "subject": {
      "description": "What was measured. Either a DNA Design Suite design (by reference, which pins the lockfile automatically) or an arbitrary construct.",
      "oneOf": [
        {
          "type": "object",
          "title": "DesignReference",
          "properties": {
            "kind": { "const": "design" },
            "job_id": { "$ref": "common.schema.json#/$defs/JobId" },
            "candidate_id": { "type": "string" },
            "as_built_digest": { "$ref": "common.schema.json#/$defs/Sha256Digest", "description": "Digest of the CodonSequence document for what was actually synthesized — the same convention as `pareto_front.candidates[].sequences[].digest`, so the two are directly comparable. Required, and checked against the candidate (CF-OBS-002): silent divergence between designed and built sequence is a common and highly corrupting error." }
          },
          "required": ["kind", "job_id", "candidate_id", "as_built_digest"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "ExplicitConstruct",
          "properties": {
            "kind": { "const": "explicit" },
            "cds": { "$ref": "common.schema.json#/$defs/CodonString" },
            "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" },
            "construct_context": { "oneOf": [{ "$ref": "construct_context.schema.json" }, { "type": "object", "properties": { "kind": { "const": "ref" }, "construct_digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" } }, "required": ["kind", "construct_digest"], "additionalProperties": false }] }
          },
          "required": ["kind", "cds", "digest"],
          "additionalProperties": false
        }
      ]
    },
    "host_id": { "$ref": "common.schema.json#/$defs/HostId" },
    "condition": { "$ref": "common.schema.json#/$defs/GrowthCondition" },
    "readouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "readout_id": { "type": "string" },
          "assay": { "enum": ["fluorescence", "luminescence", "western_blot", "rt_qpcr", "riboseq", "ms_proteomics", "growth_rate", "od600_auc", "soluble_fraction", "specific_activity", "titer", "flow_cytometry"] },
          "measures": { "enum": ["protein_abundance", "mrna_abundance", "translation_efficiency", "host_fitness", "solubility", "activity"], "description": "The latent quantity, separate from the assay. Two assays measuring the same latent quantity are poolable; two measuring different ones are not." },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "sd": { "type": ["number", "null"], "minimum": 0 },
          "n_replicates": { "type": "integer", "minimum": 1 },
          "replicate_values": { "type": "array", "items": { "type": "number" }, "default": [] },
          "normalization": {
            "type": "object",
            "properties": {
              "method": { "enum": ["none", "od_normalized", "total_protein", "reference_gene", "reference_construct", "internal_standard", "log2_fold_change_vs_control"] },
              "control_id": { "type": ["string", "null"] }
            },
            "required": ["method"],
            "additionalProperties": false
          },
          "dynamic_range": {
            "type": "object",
            "description": "Required. A value at the top of an assay's range is censored, not measured, and must enter the likelihood as such.",
            "properties": {
              "lower_limit": { "type": ["number", "null"] },
              "upper_limit": { "type": ["number", "null"] },
              "censoring": { "enum": ["none", "left", "right", "interval"] }
            },
            "required": ["censoring"],
            "additionalProperties": false
          },
          "qc_flags": { "type": "array", "items": { "enum": ["saturated", "below_loq", "outlier", "failed_control", "contaminated", "low_n"] }, "default": [] }
        },
        "required": ["readout_id", "assay", "measures", "value", "unit", "n_replicates", "normalization", "dynamic_range"],
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "description": "At least one control per submission. A readout with no control cannot be placed on a common scale with another lab's readout, which is the whole point of pooling.",
      "items": {
        "type": "object",
        "properties": {
          "control_id": { "type": "string" },
          "role": { "enum": ["negative", "positive", "reference_construct", "wild_type", "empty_vector"] },
          "cds_digest": { "type": ["string", "null"] },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] }
        },
        "required": ["control_id", "role"],
        "additionalProperties": false
      }
    },
    "exploration": {
      "type": "object",
      "properties": {
        "is_exploration_arm": { "type": "boolean" },
        "arm_id": { "type": ["string", "null"] },
        "selection_rule": { "enum": ["top_ranked", "uniform_random_from_front", "max_uncertainty", "random_feasible", "user_chosen", "unknown"] },
        "assignment_seed": { "type": ["integer", "null"] }
      },
      "required": ["is_exploration_arm", "selection_rule"],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "uri_or_doi": { "type": ["string", "null"] },
        "instrument": { "type": ["string", "null"] },
        "measured_on": { "$ref": "common.schema.json#/$defs/Iso8601" },
        "notes": { "type": "string" }
      },
      "required": ["measured_on"],
      "additionalProperties": false
    },
    "sharing": {
      "type": "object",
      "description": "ADR-0006. `community` requires an explicit, timestamped consent record; the default is private and there is no code path that changes it implicitly.",
      "properties": {
        "scope": { "enum": ["private", "tenant", "community"], "default": "private" },
        "license": { "type": ["string", "null"] },
        "consent_recorded_at": { "type": ["string", "null"] },
        "consent_actor": { "type": ["string", "null"] }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "ingest_status": {
      "type": "object",
      "description": "Set by the server, not the submitter.",
      "properties": {
        "state": { "enum": ["received", "validated", "rejected", "queued_for_recalibration", "incorporated"] },
        "validation_errors": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ProblemDetails" }, "default": [] },
        "incorporated_into": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ArtifactId" }, "default": [] }
      },
      "required": ["state"],
      "additionalProperties": false
    },
    "digest": { "$ref": "common.schema.json#/$defs/Sha256Digest" }
  },
  "required": ["schema_version", "observation_id", "submitted_at", "tenant_id", "subject", "host_id", "condition", "readouts", "controls", "exploration", "protocol", "sharing", "digest"],
  "additionalProperties": false
}
