    {
      "id": "c_bsmbi",
      "class": "blocking",
      "scope": "cds",
      "rule": {"kind": "restriction_site", "enzyme": "BsmBI", "site": "CGTCTC", "strand": "both", "max_occurrences": 0}
    }
  ],
  "repair_policy": {}
}
